COHERE_API_KEY=replace-with-your-server-side-key
COHERE_MODEL=command-a-plus-05-2026

# Gnani API values must come from your Gnani account documentation/dashboard.
GNANI_API_KEY=replace-with-your-server-side-key
GNANI_PRISMA_URL=https://api.vachana.ai/stt/v3
GNANI_PRISMA_MODEL=prisma-v3.0
# Prisma accepts up to 4 language hints, or indic-auto.
GNANI_PRISMA_LANGUAGE=hi-IN,en-IN,mr-IN
GNANI_PRISMA_FORMAT=codemix
GNANI_TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_MODEL=timbre-v3.0
# Timbre: auto | hi-IN | en-IN | mr-IN | hi-en
GNANI_TIMBRE_LANGUAGE=auto
GNANI_TIMBRE_VOICE=Avinash
GNANI_TIMEOUT_SECONDS=30

# Enables redacted provider payload metadata; raw microphone bytes are never logged.
SHABDVERSE_DEBUG_PROVIDER_LOGS=false

# Optional Poly Haven download cache directory (defaults to backend/.asset-cache).
# SHABDVERSE_ASSET_CACHE=C:\path\to\asset-cache

